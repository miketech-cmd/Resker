# ==============================================================================
# Restaurant Tracker (Resker) — Environment Variables Template
# Copy this file to .env.local for local development (never commit .env.local)
# ==============================================================================

# 1. Neon Postgres connection string (from Vercel Storage / Neon Console)
# Must include ?sslmode=require for Neon.
DATABASE_URL="postgresql://user:password@ep-example.us-west-2.aws.neon.tech/neondb?sslmode=require"

# 2. Better Auth (generate locally with: openssl rand -base64 32)
BETTER_AUTH_SECRET=""
# Local: http://localhost:3000 | Production: https://<project>.vercel.app
BETTER_AUTH_URL="http://localhost:3000"

# 3. Optional invite code required on /join (leave blank to allow open signup)
SIGNUP_INVITE_CODE=""

# 4. Google Maps Platform (Phase 2 & Phase 6)
# Server-only key (restricted to Places API (New) + Maps Experience agent tools)
GOOGLE_MAPS_SERVER_API_KEY=""
# Browser key (Development/Preview key locally; Production key in Vercel Prod)
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=""
# Vector Map ID from Google Maps Platform -> Map Management
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=""

# 5. Daily coordinate-refresh cron secret (Phase 6, generate with: openssl rand -hex 32)
CRON_SECRET=""
